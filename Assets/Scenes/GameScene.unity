      objectReference: {fileID: 0}
    - target: {fileID: 3989273781178588188, guid: 392c47005c462f847945a86bd986b009, type: 3}
      propertyPath: dataForNoMoreQuests.landmarkDescriptions.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 3989273781178588188, guid: 392c47005c462f847945a86bd986b009, type: 3}
      propertyPath: 'potentialQuests.Array.data[0].dialogues.Array.data[0]'
      value: Rabbit! I've lost a sheep in my herd!
      objectReference: {fileID: 0}
    - target: {fileID: 3989273781178588188, guid: 392c47005c462f847945a86bd986b009, type: 3}
      propertyPath: 'potentialQuests.Array.data[0].dialogues.Array.data[1]'
      value: Her name is Claara. Please find her.
      objectReference: {fileID: 0}
    - target: {fileID: 3989273781178588188, guid: 392c47005c462f847945a86bd986b009, type: 3}
      propertyPath: 'potentialQuests.Array.data[1].dialogues.Array.data[0]'
      value: Ramsey got away from the herd. Can you find him?
      objectReference: {fileID: 0}
    - target: {fileID: 3989273781178588188, guid: 392c47005c462f847945a86bd986b009, type: 3}
      propertyPath: 'potentialQuests.Array.data[2].dialogues.Array.data[0]'
      value: Yeah so a sheep in the herd Maarie is missing...
      objectReference: {fileID: 0}
    - target: {fileID: 3989273781178588188, guid: 392c47005c462f847945a86bd986b009, type: 3}
      propertyPath: 'potentialQuests.Array.data[2].dialogues.Array.data[1]'
      value: Could you help me... again
      objectReference: {fileID: 0}
    - target: {fileID: 3989273781178588188, guid: 392c47005c462f847945a86bd986b009, type: 3}
      propertyPath: 'potentialQuests.Array.data[3].dialogues.Array.data[0]'
      value: My herd is missing a sheep by the name of Baary.
      objectReference: {fileID: 0}
    - target: {fileID: 3989273781178588188, guid: 392c47005c462f847945a86bd986b009, type: 3}
      propertyPath: 'potentialQuests.Array.data[3].dialogues.Array.data[1]'
      value: Please find him. I promise this is the last time.
      objectReference: {fileID: 0}
    - target: {fileID: 3989273781178588188, guid: 392c47005c462f847945a86bd986b009, type: 3}
      propertyPath: 'dataForNoMoreQuests.landmarkDescriptions.Array.data[0]'
      value: You'll never believe this. I haven't lost any more sheep!
      objectReference: {fileID: 0}
    - target: {fileID: 3989273781178588188, guid: 392c47005c462f847945a86bd986b009, type: 3}
      propertyPath: 'dataForNoMoreQuests.landmarkDescriptions.Array.data[1]'
      value: What can I say, I'm great at my job.
      objectReference: {fileID: 0}
